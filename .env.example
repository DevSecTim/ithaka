# Postgres (docker compose up -d)
DATABASE_URL=postgres://ithaka:ithaka@localhost:5432/ithaka

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Public URLs
WEB_URL=http://localhost:3000
API_PORT=3001

# Optional: Mapbox (geocoding + map style). Without it, OSM geocoding + OpenFreeMap tiles.
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_MAPBOX_TOKEN=

# Optional: Cloudflare R2. Without it, photos store on local disk (data/uploads).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ithaka
R2_PUBLIC_URL=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3001
